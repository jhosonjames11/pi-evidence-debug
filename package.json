{
  "name": "pi-evidence-debug",
  "version": "0.1.0",
  "description": "Evidence-first debugging extension for Pi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest --run",
